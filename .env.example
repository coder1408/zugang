# Option 1 (Active): OpenRouter API key for PDF transcript extraction
# Primary: openai/gpt-6-luna (native PDF) -> Automatic Backup: mistral-ocr plugin + mistralai/mistral-small-2603
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=openai/gpt-6-luna
OPENROUTER_BACKUP_MODEL=mistralai/mistral-small-2603

# Option 2: Direct Google Gemini API key (@google/genai SDK fallback if OpenRouter key is absent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Abuse guard: max PDF extraction requests per client IP per 24h window (default: 5)
EXTRACT_DAILY_LIMIT_PER_IP=5
